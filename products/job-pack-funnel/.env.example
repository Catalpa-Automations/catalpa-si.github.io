# Server
PORT=3847
BASE_URL=http://localhost:3847

# Paystack (https://dashboard.paystack.com/#/settings/developer)
# Use TEST keys first; switch to LIVE when going live.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Product
PACK_NAME=Graduate Job-Seeker Starter Pack
# Amount in pesewas (GHS 149.00 = 14900). Suggested retail: GHS 99–250.
PACK_PRICE_PESEWAS=14900
CURRENCY=GHS

# WhatsApp delivery
# Business number in international format, no + (e.g. 233241234567)
WHATSAPP_NUMBER=233241234567
# Pre-filled message buyers send after paying (include order reference on success page)
WHATSAPP_MESSAGE=Hi! I just paid for the Graduate Job Pack. Please send my download link / add me to the tips group.

# Optional: comma-separated emails that get notified on paid webhook (requires Paystack only — log to console by default)
ADMIN_NOTIFY=true

# Demo / manual unlock (set false in production)
ALLOW_MANUAL_CONFIRM=true
MANUAL_CONFIRM_CODE=JOBPACK-DEMO
