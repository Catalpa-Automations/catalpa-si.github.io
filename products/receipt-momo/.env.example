# ReceiptMoMo — copy to .env.local for local, or set in Vercel Project Settings.

# Paystack (Ghana). Start in TEST mode, then swap to LIVE for real MoMo.
# Dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Public URL of this app (no trailing slash). Used for Paystack callback + demo links.
# Local:  http://localhost:3000
# Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: leave SECRET unset to run fully offline demo (fake payment links + webhook stub).
