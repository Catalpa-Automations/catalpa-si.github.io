# Server
PORT=3040
PUBLIC_BASE_URL=http://localhost:3040
CURRENCY=GHS

# Multi-tenant demo (folder under data/tenants/)
# Resolve order: X-Tenant-Id header → ?tenant= → /t/:id/ path → subdomain → this env
TENANT_ID=demo-ama
DEFAULT_TENANT_ID=demo-ama

# Merchant defaults
SELLER_NAME=Ama Boutique
SELLER_WHATSAPP=233241234567
LOGISTICS_WHATSAPP=233200000001

# WhatsApp Cloud API
#   mock    = no Meta tokens; sandbox API + console log (default for demos)
#   cloud   = live Meta WhatsApp Cloud API send
WHATSAPP_MODE=mock

# Meta WhatsApp Cloud API (required when WHATSAPP_MODE=cloud)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_BUSINESS_ACCOUNT_ID=
# Webhook verify token you set in Meta App → WhatsApp → Configuration
META_WA_VERIFY_TOKEN=catalpa_verify

# Paystack — https://dashboard.paystack.com/#/settings/developer
# Leave placeholder for demo MoMo page; use sk_test_… for real test charges
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
