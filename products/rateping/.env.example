# Required — from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token

# Comma-separated Telegram user IDs that can /setfuel and /grant
ADMIN_TELEGRAM_IDS=123456789

# Micro-subscription (GHS / month)
SUBSCRIPTION_GHS=15
MOMO_NUMBER=024XXXXXXX
MOMO_NAME=RatePing GH
PAYSTACK_PAYMENT_URL=https://paystack.com/pay/rateping-stub
PAYSTACK_SECRET=sk_test_stub

# Stub webhook (started with the bot)
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8787

# Alert engine
ALERT_INTERVAL_MINUTES=30
FX_MOVE_THRESHOLD_PCT=0.5
FUEL_MOVE_THRESHOLD_GHS=0.10

# Optional: pin NPA-window pump prices (GHS/litre). Overrides scrape.
# PETROL_GHS=13.50
# DIESEL_GHS=14.20

# Optional data directory (default: ./data)
# RATEPING_DATA_DIR=/absolute/path/to/data
